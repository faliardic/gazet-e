OPENAI_API_KEY=
OPENAI_MODEL=
CHATGPT_HABER_PROMPT_FILE=prompts/editorial_main_prompt.txt
NEWS_FETCH_MODE=official_rss,newsapi,gdelt
NEWSAPI_KEY=
DEFAULT_PAPER_SIZE=A3
DEFAULT_TIMEZONE=Europe/Istanbul
OUTPUT_DIR=dist
CACHE_DIR=.cache/chatgpt-haber

# Local/disposable PostgreSQL used only by the Q05 integration test gate.
GAZETE_TEST_POSTGRES_DSN=

# Q10 local loopback integration boundaries. Asset storage must be an absolute
# path outside this repository. Paid execution remains disabled until a
# separately recorded gate explicitly sets the exact value "authorized".
GAZETE_DATABASE_DSN=
GAZETE_ASSET_ROOT=
GAZETE_WORKER_ID=q10-loopback-worker
GAZETE_Q10_PAID_EXECUTION=disabled
